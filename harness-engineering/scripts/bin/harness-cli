#!/usr/bin/env bash
# Compatibility wrapper — keeps `scripts/bin/harness-cli <args>` working
# (used throughout this framework's docs) while the actual implementation
# is the auditable, source-available scripts/harness_cli.py (v3+).
# See scripts/bin/SECURITY_NOTE.md for why the old compiled binary was removed.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$HERE/../harness_cli.py" "$@"
